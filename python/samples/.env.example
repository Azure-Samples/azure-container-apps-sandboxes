# ACA Sandboxes — shared sample configuration
# Copy this file to .env and fill in the values, or run setup.py to
# provision a new sandbox group and generate .env automatically:
#
#   python python/samples/setup/setup.py
#
# Required for all samples:
AZURE_SUBSCRIPTION_ID=
ACA_RESOURCE_GROUP=my-rg
ACA_SANDBOX_GROUP=my-sandbox-group
ACA_SANDBOXGROUP_REGION=eastus2

# Optional — only needed for samples that call Azure OpenAI (03, 07, 08):
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=           (leave blank to use DefaultAzureCredential)
